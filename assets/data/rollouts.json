  "groups": [
    {
      "id": "embodiments",
      "title": "Object reorientation",
      "description": "Selected successes from separately trained policies, not matched trials across embodiments. The transparent goal object is a simulation overlay. Clips are physically trimmed through the recorded first-success frame and loop.",
      "comparison": false
    },
    {
      "id": "scaling",
      "title": "Scaling to unseen objects",
      "description": "The same unseen objects under one-object and twenty-object training. These are selected failure/success contrasts, not aggregate results. The twenty-object fork excerpt begins at source time 4 s; its goal overlay uses a different pose proxy from the evaluation metric. The fork in-point is physically trimmed; clips retain their natural recorded ends and loop.",
      "comparison": true
    },
    {
      "id": "finetune",
      "title": "Adapting a pretrained policy",
      "description": "Matched 10k-epoch budget: 5k pretraining + 5k fine-tuning versus 10k from scratch. Both adaptation stages use default resets (p = 0), with no new human demonstrations. Selected failure/success contrasts, not aggregate results. Clips retain their natural recorded ends and loop.",
      "comparison": true
    },
    {
      "id": "real",
      "title": "Zero-shot deployment",
      "comparison": false
    }
  ],
